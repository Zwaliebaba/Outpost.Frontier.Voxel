  <!--
    Asset deployment (ADR-001): the Assets folder is copied beside Outpost.exe after every build,
    so the sample runs from its output directory and under F5 alike. The executable resolves
    Assets from its own location, never from the working directory.
  -->
  <Target Name="DeployAssets" AfterTargets="Build">
    <ItemGroup>
      <OutpostAsset Include="$(SolutionDir)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(OutpostAsset)" DestinationFiles="@(OutpostAsset->'$(OutDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
